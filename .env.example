# Convex Configuration
# Get your PUBLIC_CONVEX_URL from the Convex dashboard after running: npx convex dev
PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud

# Generate a random salt for hashing IP addresses (32+ characters, cryptographically random)
# PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
VISITOR_IP_SALT=change-this-to-random-secret-32-chars-minimum
